generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum FlowStepAction {
  NAVIGATE
  CLICK
  FILL
  SELECT_OPTION
  PRESS
  WAIT_FOR_URL
  ASSERT_VISIBLE
}

enum ScenarioFamily {
  DOUBLE_ACTION
  API_FAILURE
  SLOW_RESPONSE
  REFRESH_BACK_NAVIGATION
  SESSION_EXPIRY
}

enum TestRunStatus {
  RUNNING
  COMPLETED
  BASELINE_FAILED
  ERROR
}

enum ResultKind {
  BASELINE
  SCENARIO
}

enum ResultStatus {
  PASS
  FAIL
  NEEDS_REVIEW
  ERROR
  BASELINE_REQUIRED
}

enum FailureOrigin {
  TARGET_APP_FAILURE
  GHOSTQA_ENGINE_FAILURE
}

enum ArtifactKind {
  SCREENSHOT
  TRACE
}

model Project {
  id            String    @id @default(cuid())
  name          String
  description   String?
  targetBaseUrl String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  flows         Flow[]
  testRuns      TestRun[]
}

model Flow {
  id                   String     @id @default(cuid())
  projectId            String
  name                 String
  criticalActionJson   String?
  successAssertionJson String?
  assertionsJson       String     @default("[]")
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  project              Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  steps                FlowStep[]
  scenarios            Scenario[]
  testRuns             TestRun[]

  @@index([projectId])
}

model FlowStep {
  id         String         @id @default(cuid())
  flowId     String
  stepKey    String
  position   Int
  action     FlowStepAction
  configJson String
  timeoutMs  Int?
  flow       Flow           @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, position])
  @@unique([flowId, stepKey])
}

model Scenario {
  id          String         @id @default(cuid())
  flowId      String
  scenarioKey String
  name        String
  family      ScenarioFamily
  enabled     Boolean        @default(true)
  configJson  String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  flow        Flow           @relation(fields: [flowId], references: [id], onDelete: Cascade)
  results     TestResult[]

  @@unique([flowId, scenarioKey])
  @@index([flowId, family])
}

model TestRun {
  id               String        @id @default(cuid())
  projectId        String
  flowId           String
  status           TestRunStatus @default(RUNNING)
  baselineStatus   ResultStatus?
  totalScenarios   Int           @default(0)
  passedCount      Int           @default(0)
  failedCount      Int           @default(0)
  needsReviewCount Int           @default(0)
  errorCount       Int           @default(0)
  errorMessage     String?
  createdAt        DateTime      @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  flow             Flow          @relation(fields: [flowId], references: [id], onDelete: Restrict)
  results          TestResult[]

  @@index([projectId, createdAt])
  @@index([flowId])
}

model TestResult {
  id                 String          @id @default(cuid())
  testRunId          String
  scenarioId         String?
  kind               ResultKind
  scenarioFamily     ScenarioFamily?
  status             ResultStatus
  failureOrigin      FailureOrigin?
  title              String
  summary            String
  durationMs         Int
  finalUrl           String?
  startedAt          DateTime
  completedAt        DateTime
  executionErrorJson String?
  evidenceJson       String
  observationsJson   String
  createdAt          DateTime        @default(now())
  testRun            TestRun         @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  scenario           Scenario?       @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  artifacts          Artifact[]

  @@index([testRunId])
  @@index([scenarioId])
}

model Artifact {
  id           String       @id @default(cuid())
  testResultId String
  kind         ArtifactKind
  relativePath String
  mimeType     String
  createdAt    DateTime     @default(now())
  testResult   TestResult   @relation(fields: [testResultId], references: [id], onDelete: Cascade)

  @@index([testResultId])
}

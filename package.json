{
  "name": "ghostqa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adaptive web behavior testing platform for real-world user and failure scenarios.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names server,dashboard \"npm run dev --workspace @ghostqa/server\" \"npm run dev --workspace @ghostqa/dashboard\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run prisma:generate --workspace @ghostqa/server",
    "db:migrate": "npm run prisma:migrate --workspace @ghostqa/server"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=20"
  }
}

{
  "name": "@ghostqa/test-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:capture": "npm run build && vitest run --config vitest.capture.config.ts",
    "lint": "eslint src integration vitest.capture.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.integration.json",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "@ghostqa/shared": "0.1.0",
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "vitest": "^3.2.7"
  }
}
